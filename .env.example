# =============================================================================
# itinera — environment variables reference
# Copy to .env and fill in all required values (marked with NO DEFAULT)
# =============================================================================

# --- Core infrastructure ---

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itinera
POSTGRES_USER=itinera
POSTGRES_PASSWORD=             # REQUIRED — NO DEFAULT

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=itinera
RABBITMQ_DEFAULT_PASS=         # REQUIRED — NO DEFAULT
RABBITMQ_EXCHANGE=agent.events

# --- Auth (shared by all services) ---

JWT_SECRET=                    # REQUIRED — NO DEFAULT — min 32 chars recommended
JWT_ISSUER=itinera              # optional, enables issuer validation
JWT_CONSUMER_KEY=itinera        # Kong consumer key used as `iss` claim in minted tokens
JWT_ACCESS_EXPIRY=15m           # access token lifetime (default: 15m)
JWT_REFRESH_EXPIRY=7d           # refresh token lifetime stored in Redis (default: 7d)

# --- Auth service ---

AUTH_PORT=3010
GOOGLE_CLIENT_ID=              # Google OAuth2 client ID (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=          # Google OAuth2 client secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/oauth2/google/callback
FRONTEND_URL=http://localhost

# --- Frontend (all traffic via nginx on port 80) ---

NUXT_PUBLIC_API_BASE=http://localhost
NUXT_PUBLIC_WS_URL=http://localhost

# --- AI ---

ANTHROPIC_API_KEY=             # REQUIRED — NO DEFAULT
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_PROVIDER=anthropic          # AI provider to use — currently only 'anthropic' is supported

# --- Service ports (defaults match docker-compose) ---

# orchestrator:3001, preference-agent:3002, orchestrator-agent:3003
# finance-agent:3004, logistics-agent:3005, validator:3006
# notification:3007, sharing:3008, ws-relay:3009

# --- Inter-service URLs (orchestrator needs these) ---

PREFERENCE_AGENT_URL=http://preference-agent:3002
ORCHESTRATOR_AGENT_URL=http://orchestrator-agent:3003
FINANCE_AGENT_URL=http://finance-agent:3004
LOGISTICS_AGENT_URL=http://logistics-agent:3005
VALIDATOR_URL=http://validator:3006

# --- Logistics agent: external APIs ---

OPENWEATHERMAP_API_KEY=        # REQUIRED for logistics-agent — NO DEFAULT
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org

GOOGLE_PLACES_API_KEY=         # REQUIRED for logistics-agent — NO DEFAULT
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

GOOGLE_MAPS_API_KEY=           # REQUIRED for logistics-agent — NO DEFAULT
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
# GCP project for GOOGLE_MAPS_API_KEY MUST have these APIs enabled:
#   - Distance Matrix API   (car routing / driving times)
#   - Routes API            (train/transit routing — replaces legacy Directions API)
#   - Places API (New)      (attractions / venues)
# The legacy "Directions API" is NOT used any more; transit now goes via Routes API.
# Symptom if Routes API is disabled: trains never resolve and every leg falls back
# to car (see TransportService feasibility guard, which then estimates a flight).

# --- SerpApi — Google Flights search ---
# https://serpapi.com/ — free tier 250 searches/month. The code resolves each
# destination (city/town/region) to an IATA airport (dataset match → Places
# geocode → nearest airport), then calls engine=google_flights (one-way,
# deep_search off). Empty key = flight search disabled; the feasibility guard
# then synthesises a clearly-labelled flight *estimate* for long legs.
SERPAPI_KEY=                  # Required for flight transport mode; empty = flight search disabled
SERPAPI_BASE_URL=https://serpapi.com/search

# --- Transport resolution (logistics-agent) ---
# Below this geodesic distance flights are never searched/synthesised — short
# land legs resolve to ground modes (kills fabricated flights on rural pairs
# like Mértola→Comporta, and protects the SerpApi quota).
MIN_FLIGHT_DISTANCE_KM=300
# Per-person driving cost heuristic (fuel + tolls) so car options carry a price.
CAR_COST_EUR_PER_KM=0.22
# Weighted transport ranking (TransportScorer). Lower score wins:
#   score = (COST×€ + DURATION×hours + TRANSFERS×changes) × (1 − PREFERENCE×alignment)
# alignment = fraction of journey time in the user's preferred mode, so hybrids
# like "drive to Lisboa + fly" earn partial credit under a car preference.
TRANSPORT_WEIGHT_COST=0.6
TRANSPORT_WEIGHT_DURATION=40
TRANSPORT_WEIGHT_PREFERENCE=0.18
TRANSPORT_WEIGHT_TRANSFERS=15

# Cache TTLs (seconds)
CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
ATTRACTIONS_CACHE_TTL_SECONDS=86400

# Negotiation loop — max rounds before forced convergence (card #79)
MAX_ROUNDS=6

# Orchestration engine: v2 = logistics-first WorkflowEngine (default),
# v1 = legacy round-based NegotiationLoop (kept behind this flag)
WORKFLOW_ENGINE=v2

# --- Notification service ---

SENDGRID_ENABLED=false
SENDGRID_API_KEY=              # optional — required only if SENDGRID_ENABLED=true

SMTP_HOST=mailhog              # dev SMTP server
SMTP_PORT=1025

NOTIFICATION_FROM_EMAIL=noreply@itinera.dev
NOTIFICATION_FROM_NAME=Itinera

FCM_ENABLED=false              # push notifications stub — not yet implemented
TWILIO_ENABLED=false           # SMS stub — not yet implemented

# --- Sharing service ---

SHARE_LINK_TTL_SECONDS=604800  # 7 days
SHARING_BASE_URL=http://localhost:3008
PUPPETEER_EXECUTABLE_PATH=     # optional — defaults to /usr/bin/chromium-browser

# --- Logging ---

LOG_LEVEL=info                 # debug | info | warn | error
NODE_ENV=development           # development | production | test
