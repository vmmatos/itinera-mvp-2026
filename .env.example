# =============================================================================
# itinera — environment variables reference
# Copy to .env and fill in all required values (marked with NO DEFAULT)
# =============================================================================

# --- Core infrastructure ---

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itinera
POSTGRES_USER=itinera
POSTGRES_PASSWORD=             # REQUIRED — NO DEFAULT

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=itinera
RABBITMQ_DEFAULT_PASS=         # REQUIRED — NO DEFAULT
RABBITMQ_EXCHANGE=agent.events

# --- Auth (shared by all services) ---

JWT_SECRET=                    # REQUIRED — NO DEFAULT — min 32 chars recommended
JWT_ISSUER=itinera              # optional, enables issuer validation
JWT_CONSUMER_KEY=itinera        # Kong consumer key used as `iss` claim in minted tokens

# --- Auth service ---

AUTH_PORT=3010
GOOGLE_CLIENT_ID=              # Google OAuth2 client ID (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=          # Google OAuth2 client secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/oauth2/google/callback
FRONTEND_URL=http://localhost:3000

# --- Frontend ---

NUXT_PUBLIC_API_URL=http://localhost:8000
NUXT_PUBLIC_WS_URL=http://localhost:8000

# --- AI ---

ANTHROPIC_API_KEY=             # REQUIRED — NO DEFAULT
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Service ports (defaults match docker-compose) ---

# orchestrator:3001, preference-agent:3002, orchestrator-agent:3003
# finance-agent:3004, logistics-agent:3005, validator:3006
# notification:3007, sharing:3008, ws-relay:3009

# --- Inter-service URLs (orchestrator needs these) ---

PREFERENCE_AGENT_URL=http://preference-agent:3002
ORCHESTRATOR_AGENT_URL=http://orchestrator-agent:3003
FINANCE_AGENT_URL=http://finance-agent:3004
LOGISTICS_AGENT_URL=http://logistics-agent:3005
VALIDATOR_URL=http://validator:3006

# --- Logistics agent: external APIs ---

OPENWEATHERMAP_API_KEY=        # REQUIRED for logistics-agent — NO DEFAULT
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org

GOOGLE_PLACES_API_KEY=         # REQUIRED for logistics-agent — NO DEFAULT
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

GOOGLE_MAPS_API_KEY=           # REQUIRED for logistics-agent — NO DEFAULT
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# Cache TTLs (seconds)
CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
ATTRACTIONS_CACHE_TTL_SECONDS=86400

# --- Notification service ---

SENDGRID_ENABLED=false
SENDGRID_API_KEY=              # optional — required only if SENDGRID_ENABLED=true

SMTP_HOST=mailhog              # dev SMTP server
SMTP_PORT=1025

NOTIFICATION_FROM_EMAIL=noreply@itinera.dev
NOTIFICATION_FROM_NAME=Itinera

FCM_ENABLED=false              # push notifications stub — not yet implemented
TWILIO_ENABLED=false           # SMS stub — not yet implemented

# --- Sharing service ---

SHARE_LINK_TTL_SECONDS=604800  # 7 days
SHARING_BASE_URL=http://localhost:3008
PUPPETEER_EXECUTABLE_PATH=     # optional — defaults to /usr/bin/chromium-browser

# --- Logging ---

LOG_LEVEL=info                 # debug | info | warn | error
NODE_ENV=development           # development | production | test
