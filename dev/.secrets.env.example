# Dev secrets template — committed as onboarding guide.
# Setup: cp dev/.secrets.env.example dev/.secrets.env
# Then fill all CHANGEME values before running make dev.
#
# Generate a strong secret: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Database passwords
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGEME
KONG_PG_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_PASS=CHANGEME

# ---------------------------------------------------------------------------
# JWT signing secret — openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGEME

# ---------------------------------------------------------------------------
# Anthropic API key — https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# ---------------------------------------------------------------------------
# Dev JWT consumer credentials for Kong (configure.sh uses these)
# Key = the "iss" claim in the JWT; Secret = signing secret.
# Generate secrets: openssl rand -hex 16
# ---------------------------------------------------------------------------
DEV_JWT_KEY_USER=dev-user-key
DEV_JWT_SECRET_USER=CHANGEME

DEV_JWT_KEY_ADMIN=dev-admin-key
DEV_JWT_SECRET_ADMIN=CHANGEME

DEV_JWT_KEY_SERVICE=dev-service-key
DEV_JWT_SECRET_SERVICE=CHANGEME

# ---------------------------------------------------------------------------
# Google OAuth2 — https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application), add callback URL:
#   http://localhost:8000/api/auth/oauth2/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGEME

# ---------------------------------------------------------------------------
# Notification Service — SendGrid (production email)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=SG.CHANGEME
