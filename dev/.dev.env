NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Anthropic Model
# ---------------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Kong API Gateway
# ---------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_ADMIN_URL=http://localhost:8001
KONG_PG_HOST=postgres
KONG_PG_DATABASE=kong
KONG_PG_USER=kong

# ---------------------------------------------------------------------------
# PostgreSQL (app database)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=itinera
POSTGRES_USER=itinera

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=itinera
RABBITMQ_EXCHANGE=agent.events

# ---------------------------------------------------------------------------
# JWT (non-secret config)
# ---------------------------------------------------------------------------
JWT_ISSUER=itinera
JWT_CONSUMER_KEY=itinera
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost

# ---------------------------------------------------------------------------
# Orchestrator Agent Service
# ---------------------------------------------------------------------------
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Logistics Agent Service
# ---------------------------------------------------------------------------
WEATHER_CACHE_TTL_SECONDS=1800
ATTRACTIONS_CACHE_TTL_SECONDS=86400
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org

# ---------------------------------------------------------------------------
# Service ports (used by Docker Compose + apps)
# ---------------------------------------------------------------------------
AUTH_PORT=3010
GOOGLE_CALLBACK_URL=http://localhost/api/auth/oauth2/google/callback
FRONTEND_URL=http://localhost
NUXT_PUBLIC_API_BASE=http://localhost
NUXT_PUBLIC_WS_URL=http://localhost

# ---------------------------------------------------------------------------
# Service ports (used by Docker Compose + apps)
# ---------------------------------------------------------------------------
ORCHESTRATOR_PORT=3001
PREFERENCE_AGENT_PORT=3002
ORCHESTRATOR_AGENT_PORT=3003
FINANCE_AGENT_PORT=3004
LOGISTICS_AGENT_PORT=3005
VALIDATOR_PORT=3006
NOTIFICATION_PORT=3007
SHARING_PORT=3008
WS_RELAY_PORT=3009

# ---------------------------------------------------------------------------
# Notification Service
# ---------------------------------------------------------------------------
SENDGRID_ENABLED=false
SMTP_HOST=mailhog
SMTP_PORT=1025
FCM_ENABLED=false
TWILIO_ENABLED=false
NOTIFICATION_FROM_EMAIL=noreply@itinera.dev
NOTIFICATION_FROM_NAME=Itinera

# ---------------------------------------------------------------------------
# SerpApi Google Flights (flight search in logistics-agent)
# engine=google_flights is added in code; SERPAPI_KEY lives in .secrets.env.
# ---------------------------------------------------------------------------
SERPAPI_BASE_URL=https://serpapi.com/search
