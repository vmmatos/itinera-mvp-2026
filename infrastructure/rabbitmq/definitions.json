{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    {
      "name": "agent.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "trip.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
