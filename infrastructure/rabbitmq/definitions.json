    {
      "name": "notifications",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "agent.proposals",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-message-ttl": 86400000 }
    },
    {
      "name": "agent.notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-message-ttl": 3600000 }
    },
    {
      "name": "trip.updates",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-message-ttl": 86400000 }
